<Window x:Class="GuitarNTE.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:GuitarNTE.Core;assembly=GuitarNTE.Core"
        Title="{DynamicResource UI_000}" Style="{StaticResource AppWindow}" Width="1280" Height="940" MinWidth="1020" MinHeight="720" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid x:Name="WorkspaceGrid" Margin="24,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="48" Height="48" Background="#193C3B" BorderBrush="#315D58" BorderThickness="1" CornerRadius="14" Margin="0,0,14,0"><TextBlock Text="♫" FontSize="29" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel><TextBlock x:Name="BrandTitle" Text="{DynamicResource UI_001}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource UI_002}" Foreground="#93A7C2" Margin="0,4,0,0" FontSize="12"/></StackPanel>
      </StackPanel>
      <StackPanel x:Name="LanguageControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource LanguageLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#93A7C2"/>
        <ComboBox x:Name="LanguageBox" Width="110" SelectionChanged="Language_Changed" ToolTip="中文 / English" AutomationProperties.Name="Language / 语言"><ComboBoxItem Content="中文"/><ComboBoxItem Content="English"/></ComboBox>
      <Border Margin="14,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#152C2C" BorderBrush="#2D514A" BorderThickness="1" CornerRadius="16" Padding="13,7"><TextBlock Text="{DynamicResource UI_003}" Foreground="#8BE0C7" FontSize="12"/></Border>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="4,3,4,16"><TextBlock Text="{DynamicResource UI_004}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SongCountText" Foreground="#93A7C2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></DockPanel>
            <Grid Margin="0,0,0,12">
              <TextBox x:Name="SongSearchBox" Padding="30,10,30,10" TextChanged="SongSearch_Changed" KeyDown="SongSearch_KeyDown" ToolTip="{DynamicResource UI_005}" AutomationProperties.Name="{DynamicResource UI_006}"/>
              <TextBlock Text="⌕" FontSize="22" Foreground="#93A7C2" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock Text="{DynamicResource UI_007}" Foreground="#8196AE" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SongSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              <Button x:Name="ClearSearchButton" Content="×" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="5,0" Margin="0,0,6,0" Background="Transparent" BorderBrush="Transparent" FontSize="18" Visibility="Collapsed" Click="ClearSearch_Click" ToolTip="{DynamicResource UI_008}" AutomationProperties.Name="{DynamicResource UI_008}"/>
            </Grid>
            <WrapPanel Margin="0,0,0,10"><Button Content="{DynamicResource UI_009}" Click="New_Click"/><Button Content="{DynamicResource UI_010}" Click="ImportMidi_Click" Margin="0"/></WrapPanel>
            <Button x:Name="ImportFolderButton" Content="{DynamicResource UI_011}" Click="ImportMidiFolder_Click" Margin="0,0,0,10" ToolTip="{DynamicResource UI_012}"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border Height="1" Background="#2B3B50" Margin="0,0,0,14"/>
            <UniformGrid Columns="2"><Button Content="{DynamicResource UI_013}" Click="Copy_Click"/><Button Content="{DynamicResource UI_014}" Click="Delete_Click" Margin="0" Background="#352B39" BorderBrush="#584250" Foreground="#E3B5C2"/></UniformGrid>
            <Button Content="{DynamicResource UI_015}" Click="OpenLibrary_Click" Margin="0,10,0,0" Background="Transparent"/>
            <TextBlock Text="{DynamicResource UI_016}" Foreground="#8196AE" Margin="2,12,0,0" FontSize="10" TextWrapping="Wrap"/>
          </StackPanel>
          <Grid>
            <ListBox x:Name="SongList" SelectionChanged="SongList_SelectionChanged" IsSynchronizedWithCurrentItem="False">
              <ListBox.ItemTemplate><DataTemplate>
                <StackPanel ToolTip="{Binding Title}">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#93A7C2"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{DynamicResource UI_017}"/><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="{x:Static core:Notation.NoteNames}"><Setter Property="Text" Value="{DynamicResource UI_018}"/></DataTrigger><DataTrigger Binding="{Binding Mode}" Value="{x:Static core:Notation.Midi}"><Setter Property="Text" Value="{DynamicResource UI_019}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyLibraryHint" Visibility="Collapsed" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False"><TextBlock Text="{DynamicResource UI_020}" HorizontalAlignment="Center" Foreground="#C9D7E7"/><TextBlock Text="{DynamicResource UI_021}" HorizontalAlignment="Center" FontSize="11" Foreground="#8196AE" Margin="0,8,0,0"/></StackPanel>
          </Grid>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="EditorScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,13"><TextBlock Text="{DynamicResource UI_022}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="01 / SCORE" FontSize="10" Foreground="#6D879D" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
              <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="{DynamicResource UI_023}" Click="Save_Click" Margin="12,0,0,0"/><TextBox x:Name="TitleBox" FontSize="17" FontWeight="SemiBold" TextChanged="Editor_Changed"/></DockPanel>
              <WrapPanel Margin="0,0,0,10">
                <TextBlock Text="{DynamicResource UI_024}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ModeBox" Width="116" SelectionChanged="Mode_Changed"><ComboBoxItem Content="{DynamicResource UI_017}"/><ComboBoxItem Content="{DynamicResource UI_018}"/><ComboBoxItem Content="MIDI"/></ComboBox>
                <TextBlock Text="1 =" VerticalAlignment="Center" Margin="14,0,6,0"/><TextBox x:Name="TonicBox" Width="63" Text="C4" TextChanged="Editor_Changed" ToolTip="{DynamicResource UI_025}"/>
                <Button x:Name="TemplateButton" Content="{DynamicResource UI_026}" Click="Template_Click" Margin="14,0,0,0"/>
              </WrapPanel>
              <TextBox x:Name="ScoreEditor" Height="148" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="16" VerticalContentAlignment="Top" TextChanged="Editor_Changed"/>
              <TextBlock x:Name="SyntaxHint" Foreground="#93A7C2" Margin="0,8,0,0" TextWrapping="Wrap"/>
              <StackPanel x:Name="MidiPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="{DynamicResource UI_027}" Foreground="#93A7C2"/>
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TrackPanel"/></ScrollViewer>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,14"><TextBlock Text="{DynamicResource UI_028}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="02 / PLAYBACK" FontSize="10" Foreground="#6D879D" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
              <DockPanel Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource UI_029}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="InstrumentBox" DockPanel.Dock="Left" Width="154" SelectionChanged="Instrument_Changed"><ComboBoxItem Content="{DynamicResource UI_030}"/><ComboBoxItem Content="{DynamicResource UI_031}"/></ComboBox>
                <TextBlock x:Name="InstrumentHint" Foreground="#93A7C2" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <UniformGrid Columns="6" Margin="0,0,0,12">
                <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource UI_032}" Foreground="#93A7C2" Margin="0,0,0,5"/><TextBox x:Name="BpmBox" Text="120" TextChanged="Editor_Changed"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource UI_033}" Foreground="#93A7C2" Margin="0,0,0,5"/><TextBox x:Name="SpeedBox" Text="1" TextChanged="Editor_Changed"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource UI_034}" Foreground="#93A7C2" Margin="0,0,0,5"/><TextBox x:Name="TransposeBox" Text="0" TextChanged="Editor_Changed"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource UI_035}" Foreground="#93A7C2" Margin="0,0,0,5"/><TextBox x:Name="CountdownBox" Text="5" TextChanged="Editor_Changed"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource UI_036}" Foreground="#93A7C2" Margin="0,0,0,5"/><TextBox x:Name="PressBox" Text="40" IsEnabled="False" ToolTip="{DynamicResource UI_038}" TextChanged="Editor_Changed"/></StackPanel>
                <StackPanel><TextBlock Text="{DynamicResource UI_037}" Foreground="#93A7C2" Margin="0,0,0,5"/><TextBox x:Name="LoopsBox" Text="1" TextChanged="Editor_Changed"/></StackPanel>
              </UniformGrid>
              <CheckBox x:Name="SustainBox" Content="{DynamicResource UI_039}" IsChecked="True" Margin="0,0,0,12" Checked="Editor_Changed" Unchecked="Editor_Changed"/>
              <DockPanel><Button Content="{DynamicResource UI_040}" DockPanel.Dock="Right" Click="RefreshWindows_Click" Margin="10,0,0,0"/><ComboBox x:Name="WindowBox" SelectionChanged="Window_Changed" ToolTip="{DynamicResource UI_041}"/></DockPanel>
              <Border x:Name="AccessBanner" Background="#203247" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                <DockPanel><Button x:Name="ElevateButton" Content="{DynamicResource UI_042}" DockPanel.Dock="Right" Click="Elevate_Click" Visibility="Collapsed" Margin="12,0,0,0"/><TextBlock x:Name="AccessText" Text="{DynamicResource UI_043}" TextWrapping="Wrap" Foreground="#B9CDDF" VerticalAlignment="Center"/></DockPanel>
              </Border>
              <WrapPanel Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource UI_044}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="ToggleKeyBox" Text="F8" Width="54"/>
                <TextBlock Text="{DynamicResource UI_045}" VerticalAlignment="Center" Margin="16,0,8,0"/><TextBox x:Name="StopKeyBox" Text="F9" Width="54"/>
                <Button Content="{DynamicResource UI_046}" Click="ApplySettings_Click" Margin="16,0,0,0"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <Expander x:Name="KeyboardExpander" Foreground="#E7EEF8" IsExpanded="False" HorizontalContentAlignment="Stretch">
              <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource UI_047}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource UI_048}" Foreground="#8196AE" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Expander.Header>
            <StackPanel Margin="0,16,0,0">
              <DockPanel Margin="0,0,0,12"><Button Content="{DynamicResource UI_049}" DockPanel.Dock="Right" Click="ResetMap_Click" Margin="0"/><TextBlock Text="{DynamicResource UI_050}" Foreground="#93A7C2" VerticalAlignment="Center"/></DockPanel>
              <TextBlock x:Name="KeyboardHint" Text="{DynamicResource UI_051}" Foreground="#93A7C2" Margin="0,0,0,12" TextWrapping="Wrap"/>
              <StackPanel x:Name="KeyboardPanel"/>
            </StackPanel>
            </Expander>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Background="#172C38" BorderBrush="#31525A" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,18,0,0">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <WrapPanel DockPanel.Dock="Right"><Button x:Name="PreviewButton" Content="{DynamicResource UI_052}" Click="Preview_Click"/><Button x:Name="PlayButton" Content="{DynamicResource UI_053}" Style="{StaticResource PrimaryButton}" Click="Play_Click"/><Button Content="{DynamicResource UI_054}" Background="#4A303F" BorderBrush="#785063" Foreground="#F0C5CF" Click="Stop_Click" Margin="0"/></WrapPanel>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="StatusText" Text="{DynamicResource UI_055}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ProgressText" Text="{DynamicResource UI_056}" Foreground="#A5B7CB" FontSize="12" Margin="0,5,0,0"/></StackPanel>
        </DockPanel>
        <ProgressBar x:Name="SongProgress" Height="5" Minimum="0" Maximum="1" Value="0" Foreground="#67D6BA" Background="#31465C" BorderThickness="0"/>
        <DockPanel Margin="0,8,0,0"><Button Content="{DynamicResource UI_057}" DockPanel.Dock="Right" Click="Validate_Click" Padding="8,3" Margin="8,0,0,0"/><TextBlock x:Name="ValidationText" Text="{DynamicResource UI_058}" Foreground="#A5B7CB" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
