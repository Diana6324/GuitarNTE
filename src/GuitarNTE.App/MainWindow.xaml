<Window x:Class="GuitarNTE.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:GuitarNTE.Core;assembly=GuitarNTE.Core"
        Title="Guitar NTE · 异环吉他 / 钢琴" Style="{StaticResource AppWindow}" Width="1280" Height="940" MinWidth="1020" MinHeight="720" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid x:Name="WorkspaceGrid" Margin="24,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal">
        <Border Width="48" Height="48" Background="#193C3B" BorderBrush="#315D58" BorderThickness="1" CornerRadius="14" Margin="0,0,14,0"><TextBlock Text="♫" FontSize="29" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel><TextBlock Text="GUITAR NTE" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="异环吉他 / 钢琴演奏台" Foreground="#93A7C2" Margin="0,4,0,0" FontSize="12"/></StackPanel>
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#152C2C" BorderBrush="#2D514A" BorderThickness="1" CornerRadius="16" Padding="13,7"><TextBlock Text="●  本地曲库 · 离线演奏" Foreground="#8BE0C7" FontSize="12"/></Border>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="4,3,4,16"><TextBlock Text="曲谱库" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SongCountText" Foreground="#93A7C2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></DockPanel>
            <Grid Margin="0,0,0,12">
              <TextBox x:Name="SongSearchBox" Padding="30,10,30,10" TextChanged="SongSearch_Changed" KeyDown="SongSearch_KeyDown" ToolTip="按名称搜索；多个关键词用空格分隔。Ctrl+F 搜索，Esc 清空。" AutomationProperties.Name="搜索曲谱"/>
              <TextBlock Text="⌕" FontSize="22" Foreground="#93A7C2" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock Text="搜索曲谱…" Foreground="#8196AE" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SongSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              <Button x:Name="ClearSearchButton" Content="×" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="5,0" Margin="0,0,6,0" Background="Transparent" BorderBrush="Transparent" FontSize="18" Visibility="Collapsed" Click="ClearSearch_Click" ToolTip="清空搜索" AutomationProperties.Name="清空搜索"/>
            </Grid>
            <WrapPanel Margin="0,0,0,10"><Button Content="＋ 新建" Click="New_Click"/><Button Content="导入 MIDI" Click="ImportMidi_Click" Margin="0"/></WrapPanel>
            <Button x:Name="ImportFolderButton" Content="导入文件夹" Click="ImportMidiFolder_Click" Margin="0,0,0,10" ToolTip="批量导入文件夹及子文件夹中的 .mid / .midi；不跟随目录链接，原文件保持不变。"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border Height="1" Background="#2B3B50" Margin="0,0,0,14"/>
            <UniformGrid Columns="2"><Button Content="复制" Click="Copy_Click"/><Button Content="删除副本" Click="Delete_Click" Margin="0" Background="#352B39" BorderBrush="#584250" Foreground="#E3B5C2"/></UniformGrid>
            <Button Content="打开曲库目录" Click="OpenLibrary_Click" Margin="0,10,0,0" Background="Transparent"/>
            <TextBlock Text="原始 MIDI 保持不变 · 重复导入自动跳过" Foreground="#8196AE" Margin="2,12,0,0" FontSize="10" TextWrapping="Wrap"/>
          </StackPanel>
          <Grid>
            <ListBox x:Name="SongList" SelectionChanged="SongList_SelectionChanged" IsSynchronizedWithCurrentItem="False">
              <ListBox.ItemTemplate><DataTemplate>
                <StackPanel ToolTip="{Binding Title}">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#93A7C2"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="数字简谱"/><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="{x:Static core:Notation.NoteNames}"><Setter Property="Text" Value="音名谱"/></DataTrigger><DataTrigger Binding="{Binding Mode}" Value="{x:Static core:Notation.Midi}"><Setter Property="Text" Value="MIDI · 多音轨"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyLibraryHint" Visibility="Collapsed" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False"><TextBlock Text="没有匹配的曲谱" HorizontalAlignment="Center" Foreground="#C9D7E7"/><TextBlock Text="试试其他关键词，或清空搜索" HorizontalAlignment="Center" FontSize="11" Foreground="#8196AE" Margin="0,8,0,0"/></StackPanel>
          </Grid>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="EditorScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,13"><TextBlock Text="曲谱编辑" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="01 / SCORE" FontSize="10" Foreground="#6D879D" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
              <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="保存曲谱" Click="Save_Click" Margin="12,0,0,0"/><TextBox x:Name="TitleBox" FontSize="17" FontWeight="SemiBold" TextChanged="Editor_Changed"/></DockPanel>
              <WrapPanel Margin="0,0,0,10">
                <TextBlock Text="格式" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ModeBox" Width="116" SelectionChanged="Mode_Changed"><ComboBoxItem Content="数字简谱"/><ComboBoxItem Content="音名谱"/><ComboBoxItem Content="MIDI"/></ComboBox>
                <TextBlock Text="1 =" VerticalAlignment="Center" Margin="14,0,6,0"/><TextBox x:Name="TonicBox" Width="63" Text="C4" TextChanged="Editor_Changed" ToolTip="数字简谱主音，如 C4、D4、Bb3"/>
                <Button x:Name="TemplateButton" Content="载入示例" Click="Template_Click" Margin="14,0,0,0"/>
              </WrapPanel>
              <TextBox x:Name="ScoreEditor" Height="148" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="16" VerticalContentAlignment="Top" TextChanged="Editor_Changed"/>
              <TextBlock x:Name="SyntaxHint" Foreground="#93A7C2" Margin="0,8,0,0" TextWrapping="Wrap"/>
              <StackPanel x:Name="MidiPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="选择音轨（默认排除 MIDI 第 10 通道的打击乐）" Foreground="#93A7C2"/>
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TrackPanel"/></ScrollViewer>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,14"><TextBlock Text="演奏设置" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="02 / PLAYBACK" FontSize="10" Foreground="#6D879D" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
              <DockPanel Margin="0,0,0,12">
                <TextBlock Text="乐器模式" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="InstrumentBox" DockPanel.Dock="Left" Width="132" SelectionChanged="Instrument_Changed"><ComboBoxItem Content="吉他 · 36 音"/><ComboBoxItem Content="钢琴 · 36 音"/></ComboBox>
                <TextBlock x:Name="InstrumentHint" Foreground="#93A7C2" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <UniformGrid Columns="6" Margin="0,0,0,12">
                <StackPanel Margin="0,0,10,0"><TextBlock Text="BPM · 文本谱" Foreground="#93A7C2" Margin="0,0,0,5"/><TextBox x:Name="BpmBox" Text="120" TextChanged="Editor_Changed"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="速度倍率" Foreground="#93A7C2" Margin="0,0,0,5"/><TextBox x:Name="SpeedBox" Text="1" TextChanged="Editor_Changed"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="移调 · 半音" Foreground="#93A7C2" Margin="0,0,0,5"/><TextBox x:Name="TransposeBox" Text="0" TextChanged="Editor_Changed"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="倒计时 · 秒" Foreground="#93A7C2" Margin="0,0,0,5"/><TextBox x:Name="CountdownBox" Text="5" TextChanged="Editor_Changed"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="短按 · 毫秒" Foreground="#93A7C2" Margin="0,0,0,5"/><TextBox x:Name="PressBox" Text="40" IsEnabled="False" ToolTip="取消下方长音延续选项后，此数值控制每次短按时长" TextChanged="Editor_Changed"/></StackPanel>
                <StackPanel><TextBlock Text="循环 · 次" Foreground="#93A7C2" Margin="0,0,0,5"/><TextBox x:Name="LoopsBox" Text="1" TextChanged="Editor_Changed"/></StackPanel>
              </UniformGrid>
              <CheckBox x:Name="SustainBox" Content="按乐谱时值持续按住音符（长音延续，休止松开）" IsChecked="True" Margin="0,0,0,12" Checked="Editor_Changed" Unchecked="Editor_Changed"/>
              <DockPanel><Button Content="刷新窗口" DockPanel.Dock="Right" Click="RefreshWindows_Click" Margin="10,0,0,0"/><ComboBox x:Name="WindowBox" SelectionChanged="Window_Changed" ToolTip="选择游戏窗口；仅此窗口位于前台时发送按键"/></DockPanel>
              <Border x:Name="AccessBanner" Background="#203247" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                <DockPanel><Button x:Name="ElevateButton" Content="管理员重启" DockPanel.Dock="Right" Click="Elevate_Click" Visibility="Collapsed" Margin="12,0,0,0"/><TextBlock x:Name="AccessText" Text="先选择游戏窗口，再检查输入权限。" TextWrapping="Wrap" Foreground="#B9CDDF" VerticalAlignment="Center"/></DockPanel>
              </Border>
              <WrapPanel Margin="0,12,0,0">
                <TextBlock Text="开始 / 暂停" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="ToggleKeyBox" Text="F8" Width="54"/>
                <TextBlock Text="急停" VerticalAlignment="Center" Margin="16,0,8,0"/><TextBox x:Name="StopKeyBox" Text="F9" Width="54"/>
                <Button Content="应用热键与键位" Click="ApplySettings_Click" Margin="16,0,0,0"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <Expander x:Name="KeyboardExpander" Foreground="#E7EEF8" IsExpanded="False" HorizontalContentAlignment="Stretch">
              <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="36 音键位" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="展开自定义" Foreground="#8196AE" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Expander.Header>
            <StackPanel Margin="0,16,0,0">
              <DockPanel Margin="0,0,0,12"><Button Content="恢复默认键位" DockPanel.Dock="Right" Click="ResetMap_Click" Margin="0"/><TextBlock Text="高、中、低三排音区" Foreground="#93A7C2" VerticalAlignment="Center"/></DockPanel>
              <TextBlock x:Name="KeyboardHint" Text="E3—D♯6 · 可直接编辑按键名称，应用后生效" Foreground="#93A7C2" Margin="0,0,0,12" TextWrapping="Wrap"/>
              <StackPanel x:Name="KeyboardPanel"/>
            </StackPanel>
            </Expander>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Background="#172C38" BorderBrush="#31525A" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,18,0,0">
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <WrapPanel DockPanel.Dock="Right"><Button x:Name="PreviewButton" Content="▷ 可视预演" Click="Preview_Click"/><Button x:Name="PlayButton" Content="开始演奏" Style="{StaticResource PrimaryButton}" Click="Play_Click"/><Button Content="■ 急停" Background="#4A303F" BorderBrush="#785063" Foreground="#F0C5CF" Click="Stop_Click" Margin="0"/></WrapPanel>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="StatusText" Text="准备就绪" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ProgressText" Text="先校验乐谱，再切回游戏开始演奏" Foreground="#A5B7CB" FontSize="12" Margin="0,5,0,0"/></StackPanel>
        </DockPanel>
        <ProgressBar x:Name="SongProgress" Height="5" Minimum="0" Maximum="1" Value="0" Foreground="#67D6BA" Background="#31465C" BorderThickness="0"/>
        <DockPanel Margin="0,8,0,0"><Button Content="校验乐谱" DockPanel.Dock="Right" Click="Validate_Click" Padding="8,3" Margin="8,0,0,0"/><TextBlock x:Name="ValidationText" Text="支持 MIDI / 数字简谱 / 音名谱；演奏前请先进入游戏对应乐器界面。" Foreground="#A5B7CB" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
